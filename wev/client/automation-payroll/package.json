    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@primeuix/themes": "^3.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "axios": "^1.21.1",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "motion-v": "^2.13.0",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.13",
    "vue-router": "^5.5.1",
    "vuetify": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
