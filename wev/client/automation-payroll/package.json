{
  "name": "automation-payroll",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "bun --watch server/index.ts",
    "dev:stack": "concurrently -k -n api,web -c cyan,green \"bun run dev:api\" \"bun run dev:web\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
